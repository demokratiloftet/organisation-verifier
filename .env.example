# Defaults for a local Node process. Compose sets these itself.
APP_ORIGIN=http://127.0.0.1:3012
HOST=127.0.0.1
PORT=3012
DATABASE_PATH=./data/verifier.sqlite
# The default isolated fixture has no host ports; use pnpm demo:up for the full stack.
FIXTURE_URL=http://127.0.0.1:2584

# Standalone Node: opt-in background processing. Compose uses compose.automation.yaml.
AUTOMATION_ENABLED=false
# 1–8 concurrent checks; default 4. The pool starts at most four jobs/second.
WORKER_CONCURRENCY=4
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
# Off until an issuer, policy and pilot list are agreed. Never put a password here.
PUBLIC_ISSUANCE_ENABLED=false
# Own VPS only; mutually exclusive with public issuance. See docs/private-issuer.md.
PRIVATE_ISSUANCE_ENABLED=false
ISSUER_PDS=
ISSUER_DID=
ISSUER_IDENTIFIER=
ISSUER_PASSWORD_FILE=
PILOT_ORGNRS=

# Authenticated HTTPS deployment (see compose.internet.yaml).
OPERATOR_CREDENTIALS_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
